# Copy to `.env` (Docker) or `.env.local` (npm run dev) and fill in.
# Never commit the real file.

# --- Required in production -------------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=

# --- Database ---------------------------------------------------------------
# Local dev (docker compose up -d db exposes Postgres on localhost:5433):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/topshelf
# Docker: password for the bundled Postgres container (only applied when the
# data volume is first created).
POSTGRES_PASSWORD=postgres

# --- Optional ---------------------------------------------------------------
# Public base URL, used in links inside emails.
NEXT_PUBLIC_APP_URL=http://localhost:6050
# Set to true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Set to true to stop the background scheduler (report / alert emails).
DISABLE_SCHEDULER=false
